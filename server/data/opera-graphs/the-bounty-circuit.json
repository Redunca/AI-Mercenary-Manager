{
  "id": "the-bounty-circuit",
  "title": "The Bounty Circuit",
  "titles": [
    "Open to Any Outfit",
    "First Contact Wins",
    "The Field Thins"
  ],
  "description": "Multiple mercenary outfits are chasing the same marked bounty -- the crew isn't just doing the job, it's racing rivals doing the same job.",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "text": "A bounty on {targetName} clears the board near {planetName}, open to any outfit that can close it. {enemyGroupName} already has a head start.",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "act1-verify",
      "type": "mission",
      "mission": {
        "title": "Confirm the Mark",
        "description": "{targetName} may or may not still be where the board claims -- verify it before committing a ship to the chase.",
        "difficulty": "ROUTINE",
        "tags": [
          "recon"
        ],
        "missionType": "RECON"
      },
      "position": {
        "x": 300,
        "y": -150
      }
    },
    {
      "id": "act1-registry",
      "type": "seed",
      "seeds": [
        {
          "target": "shop",
          "params": {
            "itemName": "Bounty Circuit Registration"
          },
          "note": "Buy-in papers for the circuit's official registry make the rounds, guaranteeing a cut to whoever actually holds them."
        }
      ],
      "completionText": "The registration is filed.",
      "position": {
        "x": 300,
        "y": 0
      }
    },
    {
      "id": "act1-reputation",
      "type": "story",
      "text": "The crew's name is already circulating among circuit regulars, on the strength of the last job alone.",
      "effects": [],
      "position": {
        "x": 300,
        "y": 150
      }
    },
    {
      "id": "bridge-1",
      "type": "story",
      "text": "Word is moving fast. So is everyone else chasing the same bounty.",
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "id": "act2-delay",
      "type": "mission",
      "mission": {
        "title": "Slow the Competition",
        "description": "Quietly delay {enemyGroupName}'s outfit without tipping them off it was the crew.",
        "difficulty": "STANDARD",
        "tags": [
          "sabotage"
        ],
        "missionType": "SABOTAGE"
      },
      "position": {
        "x": 900,
        "y": -150
      }
    },
    {
      "id": "act2-approach",
      "type": "mission",
      "mission": {
        "title": "Beat Them to the Approach",
        "description": "Find a faster route to {targetName} before {enemyGroupName} does.",
        "difficulty": "STANDARD",
        "tags": [
          "recon"
        ],
        "missionType": "RECON"
      },
      "position": {
        "x": 900,
        "y": 0
      }
    },
    {
      "id": "act2-defector",
      "type": "seed",
      "seeds": [
        {
          "target": "candidate",
          "params": {
            "seedId": "circuit-defector"
          },
          "note": "A regular running with {enemyGroupName} sends word they're open to switching outfits mid-race, for the right offer."
        }
      ],
      "completionText": "The defector switches sides.",
      "position": {
        "x": 900,
        "y": 150
      }
    },
    {
      "id": "bridge-2",
      "type": "story",
      "text": "The field is thinner than it was. {enemyGroupName} is still in it.",
      "position": {
        "x": 1200,
        "y": 0
      }
    },
    {
      "id": "act3-corner",
      "type": "mission",
      "mission": {
        "title": "Corner the Mark",
        "description": "Get {targetName} cornered near {planetName} and the claim locked down before anyone else gets close.",
        "difficulty": "HARD",
        "tags": [
          "extraction"
        ],
        "missionType": "EXTRACTION_OP"
      },
      "position": {
        "x": 1500,
        "y": -150
      }
    },
    {
      "id": "act3-corner-payoff",
      "type": "story",
      "text": "The claim is locked down, timestamped and witnessed before anyone else gets within a system of it.",
      "effects": [
        {
          "type": "give_item",
          "params": {
            "itemName": "Confirmed Bounty Claim"
          }
        }
      ],
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "act3-forced",
      "type": "story",
      "text": "{enemyGroupName} makes its move early, forcing every outfit still in the running to show its hand.",
      "effects": [],
      "position": {
        "x": 1500,
        "y": 0
      }
    },
    {
      "id": "act3-cutoff",
      "type": "mission",
      "mission": {
        "title": "Cut Off the Backup Route",
        "description": "Deny {enemyGroupName} a second attempt, in case the first one goes bad.",
        "difficulty": "STANDARD",
        "tags": [
          "sabotage"
        ],
        "missionType": "SABOTAGE"
      },
      "position": {
        "x": 1500,
        "y": 150
      }
    },
    {
      "id": "bridge-3",
      "type": "story",
      "text": "Whatever happens next, this bounty is closing one way or another.",
      "position": {
        "x": 2100,
        "y": 0
      }
    },
    {
      "id": "finale-choice",
      "type": "choice",
      "text": "How does the circuit close?",
      "choiceOptions": [
        {
          "id": "claim",
          "label": "Bring in the mark"
        },
        {
          "id": "sabotage",
          "label": "Take {enemyGroupName} out of the running"
        },
        {
          "id": "split",
          "label": "Cut a deal to split it"
        },
        {
          "id": "walkaway",
          "label": "Let the circuit have this one"
        }
      ],
      "position": {
        "x": 2400,
        "y": 0
      }
    },
    {
      "id": "finale-claim-bonus-payoff",
      "type": "story",
      "text": "With the claim already locked down, bringing the mark in is paperwork, not a fight.",
      "effects": [
        {
          "type": "apply_perk",
          "params": {
            "perkName": "Circuit Ringer"
          }
        }
      ],
      "position": {
        "x": 2700,
        "y": -300
      }
    },
    {
      "id": "finale-claim-bonus-end",
      "type": "end",
      "outcome": "success",
      "text": "The bounty closes uncontested. The paperwork was airtight before anyone else even arrived.",
      "position": {
        "x": 3000,
        "y": -450
      }
    },
    {
      "id": "finale-claim-mission",
      "type": "mission",
      "mission": {
        "title": "Bring in the Mark",
        "description": "No lock on the claim, no shortcuts -- just bring {targetName} in before {enemyGroupName} does.",
        "difficulty": "PERILOUS",
        "tags": [
          "extraction"
        ],
        "missionType": "EXTRACTION_OP"
      },
      "position": {
        "x": 2700,
        "y": -150
      }
    },
    {
      "id": "finale-claim-success-payoff",
      "type": "story",
      "text": "It comes down to the wire, but the crew brings the mark in first.",
      "effects": [
        {
          "type": "apply_perk",
          "params": {
            "perkName": "Hard-Won Bounty"
          }
        }
      ],
      "position": {
        "x": 3000,
        "y": -300
      }
    },
    {
      "id": "finale-claim-success-end",
      "type": "end",
      "outcome": "success",
      "text": "The bounty closes in the crew's favor. It was closer than anyone aboard is admitting.",
      "position": {
        "x": 3300,
        "y": -300
      }
    },
    {
      "id": "finale-claim-fail-payoff",
      "type": "story",
      "text": "{enemyGroupName} closes it first. The circuit remembers who almost had it.",
      "effects": [
        {
          "type": "apply_flaw",
          "params": {
            "flawName": "Also-Ran"
          }
        }
      ],
      "position": {
        "x": 3000,
        "y": -150
      }
    },
    {
      "id": "finale-claim-fail-end",
      "type": "end",
      "outcome": "failure",
      "text": "The mark goes to {enemyGroupName}. The crew walks away with nothing but the story of how close it was.",
      "position": {
        "x": 3300,
        "y": -150
      }
    },
    {
      "id": "finale-sabotage-mission",
      "type": "mission",
      "mission": {
        "title": "Take {enemyGroupName} Out of the Running",
        "description": "Ground {enemyGroupName}'s outfit outright before they can close on {targetName}.",
        "difficulty": "HARD",
        "tags": [
          "sabotage"
        ],
        "missionType": "SABOTAGE"
      },
      "position": {
        "x": 2700,
        "y": 0
      }
    },
    {
      "id": "finale-sabotage-success-payoff",
      "type": "story",
      "text": "{enemyGroupName}'s outfit is grounded for good. The rest of the circuit takes notice of who did it.",
      "effects": [
        {
          "type": "apply_perk",
          "params": {
            "perkName": "Feared on the Circuit"
          }
        }
      ],
      "position": {
        "x": 3000,
        "y": 0
      }
    },
    {
      "id": "finale-sabotage-success-end",
      "type": "end",
      "outcome": "success",
      "text": "The competition is gone. What happens to the bounty after that is barely a footnote.",
      "position": {
        "x": 3300,
        "y": 0
      }
    },
    {
      "id": "finale-sabotage-fail-payoff",
      "type": "story",
      "text": "The attempt is traced straight back to the crew, in front of the entire circuit.",
      "effects": [
        {
          "type": "apply_flaw",
          "params": {
            "flawName": "Exposed"
          }
        }
      ],
      "position": {
        "x": 3000,
        "y": 150
      }
    },
    {
      "id": "finale-sabotage-fail-end",
      "type": "end",
      "outcome": "failure",
      "text": "The sabotage fails in the open. Every outfit on the circuit knows exactly who to watch now.",
      "position": {
        "x": 3300,
        "y": 150
      }
    },
    {
      "id": "finale-split-mission",
      "type": "mission",
      "mission": {
        "title": "Cut a Deal",
        "description": "Propose splitting the bounty with {enemyGroupName} rather than risk losing it all.",
        "difficulty": "STANDARD",
        "tags": [
          "diplomacy"
        ],
        "missionType": "DIPLOMACY"
      },
      "position": {
        "x": 2700,
        "y": 150
      }
    },
    {
      "id": "finale-split-success-payoff",
      "type": "story",
      "text": "Neither side loves the split. Both sides take it.",
      "effects": [
        {
          "type": "apply_perk",
          "params": {
            "perkName": "Fair Split"
          }
        }
      ],
      "position": {
        "x": 3000,
        "y": 300
      }
    },
    {
      "id": "finale-split-success-end",
      "type": "end",
      "outcome": "success",
      "text": "The bounty gets split down the middle. Smaller than a clean win, guaranteed all the same.",
      "position": {
        "x": 3300,
        "y": 300
      }
    },
    {
      "id": "finale-split-fail-end",
      "type": "end",
      "outcome": "neutral",
      "text": "The offer falls flat. {enemyGroupName} was never interested in sharing.",
      "position": {
        "x": 3000,
        "y": 450
      }
    },
    {
      "id": "finale-walkaway-end",
      "type": "end",
      "outcome": "neutral",
      "text": "The crew lets the circuit have this one. Not every bounty is worth the chase.",
      "position": {
        "x": 2700,
        "y": 300
      }
    }
  ],
