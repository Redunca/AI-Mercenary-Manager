{
  "id": "standing-arrangement",
  "title": "Standing Arrangement",
  "titles": [
    "Off the Books",
    "Something Worth Keeping",
    "Unscheduled"
  ],
  "description": "Two recruits start drilling together off the books. What starts as practice becomes something worth keeping.",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "text": "Maintenance logs flag an odd pattern: the same gear, checked out in pairs, against no scheduled mission.",
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "beat1a",
      "type": "story",
      "text": "Maintenance logs show the same gear checked out twice this week, by two different names, for no scheduled mission.",
      "effects": [],
      "position": {
        "x": 300,
        "y": -75
      }
    },
    {
      "id": "beat1b",
      "type": "story",
      "text": "Two recruits keep ending up on the same range slot, unscheduled, more nights than not.",
      "effects": [],
      "position": {
        "x": 300,
        "y": 75
      }
    },
    {
      "id": "seed1",
      "type": "seed",
      "seeds": [
        {
          "target": "shop",
          "params": {
            "itemName": "Matched Training Gear"
          },
          "note": "A matched set turns up in the requisition catalog, sized for two."
        }
      ],
      "completionText": "Logged in the requisition catalog.",
      "position": {
        "x": 600,
        "y": 0
      }
    },
    {
      "id": "bridge1",
      "type": "story",
      "text": "One name goes on the roster for the arrangement. Command wants a second before it is official.",
      "effects": [],
      "position": {
        "x": 900,
        "y": 0
      }
    },
    {
      "id": "prep",
      "type": "story",
      "text": "Pairing confirmed. The next contract goes to both of them.",
      "effects": [],
      "position": {
        "x": 1200,
        "y": 0
      }
    },
    {
      "id": "mission2a",
      "type": "mission",
      "mission": {
        "title": "Paired Sabotage Run",
        "description": "Two sets of hands on one objective on {planetName} -- cut the risk of anyone working alone.",
        "difficulty": "STANDARD",
        "tags": [
          "urban"
        ],
        "missionType": "SABOTAGE"
      },
      "completionText": "Objective down. Neither of them went in alone.",
      "position": {
        "x": 1500,
        "y": -75
      }
    },
    {
      "id": "mission2b",
      "type": "mission",
      "mission": {
        "title": "Paired Recon Sweep",
        "description": "A quiet sweep of {planetName}, one watching, one moving -- exactly how they have been drilling it.",
        "difficulty": "STANDARD",
        "tags": [
          "frontier"
        ],
        "missionType": "RECON"
      },
      "completionText": "Sweep complete. The drilling shows.",
      "position": {
        "x": 1500,
        "y": 75
      }
    },
    {
      "id": "bridge2",
      "type": "story",
      "text": "The contract closes. The arrangement, whatever it is now, keeps going.",
      "effects": [],
      "position": {
        "x": 1800,
        "y": 0
      }
    },
    {
      "id": "finale-choice",
      "type": "choice",
      "text": "How do they treat the next round?",
      "choiceOptions": [
        {
          "id": "push",
          "label": "Push each other to the limit"
        },
        {
          "id": "ease",
          "label": "Keep it friendly, ease off"
        }
      ],
      "position": {
        "x": 2100,
        "y": 0
      }
    },
    {
      "id": "payoff-push-bonus",
      "type": "story",
      "text": "With the matched gear finally paying off, the drill turns into something close to instinct. Neither one is holding back anymore.",
      "effects": [
        {
          "type": "adjust_relationship",
          "params": {
            "amount": 35
          }
        }
      ],
      "position": {
        "x": 2400,
        "y": -150
      }
    },
    {
      "id": "end-push-bonus",
      "type": "end",
      "outcome": "success",
      "text": "The arrangement stops being informal. Whatever this is, it is not going away.",
      "position": {
        "x": 2700,
        "y": -150
      }
    },
    {
      "id": "payoff-push-standard",
      "type": "story",
      "text": "No matched gear, no shortcuts -- they push through it anyway, the hard way.",
      "effects": [
        {
          "type": "adjust_relationship",
          "params": {
            "amount": 22
          }
        }
      ],
      "position": {
        "x": 2400,
        "y": 0
      }
    },
    {
      "id": "end-push-standard",
      "type": "end",
      "outcome": "success",
      "text": "It cost more effort than it should have. It worked anyway.",
      "position": {
        "x": 2700,
        "y": 0
      }
    },
    {
      "id": "payoff-ease",
      "type": "story",
      "text": "They keep it light, no score being kept between them.",
      "effects": [
        {
          "type": "adjust_relationship",
          "params": {
            "amount": 18
          }
        }
      ],
      "position": {
        "x": 2400,
        "y": 150
      }
    },
    {
      "id": "end-ease",
      "type": "end",
      "outcome": "success",
      "text": "Not everything has to be a test. This still counts.",
      "position": {
        "x": 2700,
        "y": 150
      }
    }
  ],
